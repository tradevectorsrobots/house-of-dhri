  hallmark: '<path d="M12 2.8 19.5 7v10L12 21.2 4.5 17V7z"/><path d="m8.6 12.2 2.3 2.3 4.6-4.7"/>',
  silver: '<path d="M2.8 16.5 6 8.5h12l3.2 8z"/><path d="M2.8 16.5h18.4M9 11.5h6"/>',
