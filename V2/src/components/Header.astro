---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { NAV, wa } from "../data/site.js";

const path = Astro.url.pathname;
const current = (href) => path === href || (href !== "/" && path.startsWith(href));
---
<header class="site-header on-dark">
  <div class="wrap site-header__bar">
    <a href="/" class="site-header__home" aria-label="House of Dhri, home"><Logo /></a>
    <nav class="site-header__nav" aria-label="Main">
      <ul>
        {NAV.map((l) => (
          <li><a href={l.href} aria-current={current(l.href) ? "page" : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <a href="/contact/" class="btn btn--pearl site-header__cta">Talk to us</a>
    </nav>
    <button type="button" class="site-header__menu" data-menu-open aria-haspopup="dialog" aria-controls="menu">
      <Icon name="menu" />
      <span>Menu</span>
    </button>
  </div>
</header>

<dialog id="menu" class="menu on-dark" aria-label="Menu">
  <div class="wrap menu__top">
    <a href="/" aria-label="House of Dhri, home"><Logo /></a>
    <button type="button" class="site-header__menu" data-menu-close>
      <Icon name="close" />
      <span>Close</span>
    </button>
  </div>
  <nav class="wrap menu__nav" aria-label="Main">
    <ul>
      <li><a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a></li>
      {NAV.map((l) => (
        <li><a href={l.href} aria-current={current(l.href) ? "page" : undefined}>{l.label}</a></li>
      ))}
      <li><a href="/contact/" aria-current={current("/contact/") ? "page" : undefined}>Talk to us</a></li>
    </ul>
    <a href={wa()} class="btn btn--pearl menu__wa" target="_blank" rel="noopener">
      <Icon name="chat" /> Message us on WhatsApp
    </a>
  </nav>
</dialog>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; border-bottom: 1px solid var(--line-on-dark); }
  .site-header__bar { display: flex; align-items: center; justify-content: space-between; min-height: 4.5rem; gap: 1.5rem; }
  .site-header__home { display: inline-flex; text-decoration: none; padding-block: 0.5rem; }
  .site-header__nav { display: none; align-items: center; gap: 2rem; }
  .site-header__nav ul { display: flex; gap: 1.6rem; list-style: none; margin: 0; padding: 0; }
  .site-header__nav a:not(.btn) {
    font-size: 0.95rem; text-decoration: none; color: rgb(238 240 236 / 0.82);
    padding-block: 0.4rem; border-bottom: 1px solid transparent; transition: color 0.2s, border-color 0.2s;
  }
  .site-header__nav a:not(.btn):hover { color: var(--pearl); }
  .site-header__nav a[aria-current="page"] { color: var(--pearl); border-bottom-color: var(--sona); }
  .site-header__cta { min-height: 2.6rem; padding: 0.55rem 1.2rem; font-size: 0.95rem; }
  .site-header__menu {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0.5rem 0.25rem;
    background: none; border: 0; color: var(--pearl); cursor: pointer; font-size: 0.95rem;
  }
  .site-header__menu :global(svg) { width: 1.4rem; height: 1.4rem; }
  @media (min-width: 1180px) {
    .site-header__nav { display: flex; }
    .site-header__menu { display: none; }
  }

  .menu {
    width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; border: 0;
    inset: 0; overflow-y: auto; overscroll-behavior: contain;
  }
  .menu::backdrop { background: var(--panna); }
  .menu[open] { animation: menu-in 0.35s var(--ease); }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-0.75rem); } }
  .menu__top { display: flex; align-items: center; justify-content: space-between; min-height: 4.5rem; border-bottom: 1px solid var(--line-on-dark); }
  .menu__top > a { display: inline-flex; padding-block: 0.5rem; }
  .menu__nav { display: grid; gap: 2.5rem; padding-block: 2rem 3rem; }
  .menu__nav ul { list-style: none; margin: 0; padding: 0; }
  .menu__nav li { border-bottom: 1px solid var(--line-on-dark); }
  .menu__nav li a {
    display: block; padding-block: 0.85rem; text-decoration: none;
    font-family: var(--display); font-variation-settings: "SOFT" 100; font-weight: 360;
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.5rem); line-height: 1.15;
  }
  .menu__nav li a[aria-current="page"] { color: var(--sona-light); }
  .menu__wa { justify-self: start; }
</style>
