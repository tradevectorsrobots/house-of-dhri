---
import Icon from "./Icon.astro";
import { PRODUCTS } from "../data/products.js";
import { getCollection, waLink } from "../data/site.js";
---
<div data-quickview class="contents">
  <div data-qv-close class="qv-overlay fixed inset-0 z-50 bg-black/80"></div>
  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="quickview-title"
    tabindex="-1"
    data-lenis-prevent
    data-testid="quickview-panel"
    data-qv-panel
    class="qv-panel fixed z-50 inset-y-0 right-0 h-full w-full sm:max-w-[540px] p-0 gap-0 overflow-y-auto overscroll-contain bg-[#26231F] border-l border-l-[#F6F1E8]/10 shadow-lg"
  >
    <div data-qv-body></div>
    <button
      type="button"
      data-qv-close
      class="tap-target absolute right-4 top-4 z-20 rounded-full bg-[#26231F] p-2.5 opacity-100 transition-opacity hover:opacity-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#B39A70]"
    >
      <Icon name="x" class="h-4 w-4" />
      <span class="sr-only">Close</span>
    </button>
  </div>
  {PRODUCTS.map((p) => {
    const c = getCollection(p.collection);
    const specs = p.specs.slice(0, 4);
    return (
      <template data-qv-template={p.slug}>
        <div class="relative aspect-[4/5] sm:aspect-[5/5] overflow-hidden bg-[#2E2A25]">
          {p.images.map((src, k) => (
            <img
              src={src}
              alt={`${p.name} view ${k + 1}`}
              data-testid="quickview-image"
              data-qv-img={k}
              class={`qv-img absolute inset-0 h-full w-full object-cover ${k === 0 ? "is-current" : ""}`}
            />
          ))}
          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between">
            <span class="overline text-[0.6rem] bg-[#26231F]/85 backdrop-blur px-3 py-1.5">Design render</span>
            <div class="flex gap-2">
              {p.images.map((_, k) => (
                <button
                  type="button"
                  data-qv-dot={k}
                  data-testid={`quickview-dot-${k}`}
                  aria-label={`Show view ${k + 1}`}
                  aria-pressed={k === 0 ? "true" : "false"}
                  class={`tap-target h-2.5 rounded-full transition-[width,background-color] duration-500 ${k === 0 ? "w-8 bg-[#26231F]" : "w-2.5 bg-[#26231F]/50"}`}
                ></button>
              ))}
            </div>
          </div>
        </div>
        <div class="p-7 sm:p-10">
          <p class="overline text-[#CDB894]">{c.name} · {c.line}</p>
          <h2 id="quickview-title" data-testid="quickview-name" class="font-display font-light text-5xl leading-[0.95] mt-4 text-[#F6F1E8]">
            {p.name}
          </h2>
          <p class="mt-3 text-base text-[#F6F1E8]/70">{p.line}</p>
          <p class="mt-5 font-display italic text-2xl text-[#CDB894]">Price on enquiry</p>
          <p class="mt-5 text-[#F6F1E8]/80 leading-relaxed">{p.note}</p>
          <dl class="mt-8 border-t border-[#F6F1E8]/15">
            {specs.map((s) => (
              <div class="grid grid-cols-[110px_1fr] gap-4 py-3 border-b border-[#F6F1E8]/15">
                <dt class="overline text-[0.6rem] text-[#CDB894] pt-1">{s.label}</dt>
                <dd class="font-display text-lg">{s.value}</dd>
              </div>
            ))}
          </dl>
          <a
            href={waLink(`Hello House of Dhri, I'd like to enquire about "${p.name}" (${c.name}).`)}
            target="_blank"
            rel="noreferrer"
            data-testid="quickview-whatsapp-button"
            class="mt-8 flex items-center justify-center gap-3 rounded-full bg-[#F6F1E8] text-[#26231F] py-4 text-sm tracking-[0.12em] uppercase transition-colors duration-300 hover:bg-[#B39A70]"
          >
            <Icon name="message-circle" class="h-4 w-4" strokeWidth={1.5} /> Enquire on WhatsApp
          </a>
          <a
            href={`/pieces/${p.slug}`}
            data-testid="quickview-details-link"
            class="mt-3 flex items-center justify-center gap-2 rounded-full border border-[#F6F1E8]/30 py-4 text-sm tracking-[0.12em] uppercase transition-colors duration-300 hover:bg-[#F6F1E8] hover:text-[#26231F]"
          >
            View full details <Icon name="arrow-up-right" class="h-4 w-4" strokeWidth={1.4} />
          </a>
          <p class="mt-6 text-xs text-[#F6F1E8]/65 leading-relaxed">Final metal, stone and grading details are confirmed with you personally on enquiry.</p>
        </div>
      </template>
    );
  })}
</div>
