---
import Img from "./Img.astro";
import { wa } from "../data/site.js";

const { d, sizes = "(min-width: 1100px) 30vw, (min-width: 640px) 45vw, 80vw", ratio = "4 / 5" } = Astro.props;
---
<article class="design" data-type={d.type}>
  <div class="photo design__photo" style={`aspect-ratio: ${ratio}`}>
    <Img name={d.image} sizes={sizes} widths={[400, 700, 1000]} />
  </div>
  <h3>{d.name}</h3>
  <p class="muted">{d.detail}</p>
  <a class="text-link" href={wa(`Hello House of Dhri, I would like to talk about the ${d.name} design.`)} target="_blank" rel="noopener">
    Ask about this design<span class="sr-only">: {d.name}</span>
  </a>
</article>

<style>
  .design { display: grid; gap: 0.5rem; align-content: start; }
  .design__photo { margin-bottom: 0.75rem; }
  .design__photo :global(img) { transition: transform 0.6s var(--ease); }
  .design:hover .design__photo :global(img) { transform: scale(1.03); }
  .design h3 { font-size: var(--step-2); }
  .design .text-link { justify-self: start; margin-top: 0.35rem; font-size: 0.95rem; }
</style>
