---
import Base from "../../layouts/Base.astro";
import PageIntro from "../../components/PageIntro.astro";
import Img from "../../components/Img.astro";
import Faq from "../../components/Faq.astro";
import { FAQ_DIAMONDS } from "../../data/faqs.js";
import { breadcrumbs, faqPage } from "../../data/seo.js";

const COMPARE = [
  ["How it forms", "Deep in the earth, under heat and pressure, over billions of years", "In a chamber, from a thin diamond seed and carbon rich gas, over a few weeks"],
  ["What it is", "A pure carbon crystal", "A pure carbon crystal, the same as natural"],
  ["How it looks", "Graded on cut, colour, clarity and carat", "Graded on exactly the same scale"],
  ["Certificate", "A grading report from a gem lab", "A grading report that also states the stone is lab grown"],
  ["Price", "Higher, because it is rarer", "Usually much lower for the same size and quality"],
  ["Choose it for", "Rarity and tradition", "A bigger or cleaner stone for your budget"],
];

const FOUR_C = [
  ["Cut", "How well the diamond is shaped and polished. It decides the sparkle more than anything else."],
  ["Colour", "Graded from D, which is colourless, down the alphabet to warmer tints. Close grades look the same to most eyes."],
  ["Clarity", "Tiny marks inside or on the stone. Many can only be seen under magnification."],
  ["Carat", "The weight of the diamond. One carat is 0.2 grams."],
];

const GOLD = [
  ["24K", "99.9%", "Too soft for most jewellery. Used for coins and bars."],
  ["22K", "91.6%", "The traditional choice for Indian gold jewellery."],
  ["18K", "75%", "Strong enough to hold diamonds safely. Our usual choice for rings."],
  ["14K", "58.5%", "The hardest wearing. Good for rings you never take off."],
];

const CHECKS = [
  "Metal purity is checked before casting.",
  "Every stone is checked under magnification after it is set.",
  "Each finished piece is weighed, and the weight goes on your bill.",
  "Vidhi or her husband approves every piece before it leaves the workshop.",
  "You receive the diamond certificate and an itemised bill with the metal, purity and weight.",
];

const schema = [breadcrumbs([["Home", "/"], ["Diamonds & certification", "/diamonds-and-certification/"]]), faqPage(FAQ_DIAMONDS)];
---
<Base
  title="Natural vs lab grown diamonds and gold purity"
  description="A plain guide to natural and lab grown (CVD) diamonds, the 4Cs, gold karats, BIS hallmarks and 925 silver, and how we check every piece."
  og="loose-diamonds"
  schema={schema}
>
  <PageIntro
    title="Know exactly what you are buying"
    lede="We work with natural diamonds, lab grown (CVD) diamonds, hallmarked gold and 925 silver. Here is how they differ, what the paperwork means and how we check every piece before it reaches you."
    image="diamond-tweezers"
    ratio="4 / 3"
    crumbs={[["Home", "/"], ["Diamonds & certification"]]}
  />

  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2>Natural and lab grown diamonds</h2>
        <p>Both are real diamonds. You cannot tell them apart by eye. What changes is where they come from and what they cost.</p>
      </div>
      <table class="compare">
        <caption class="sr-only">Natural and lab grown diamonds compared</caption>
        <thead>
          <tr><td></td><th scope="col">Natural</th><th scope="col">Lab grown (CVD)</th></tr>
        </thead>
        <tbody>
          {COMPARE.map(([k, a, b]) => (
            <tr>
              <th scope="row">{k}</th>
              <td data-label="Natural">{a}</td>
              <td data-label="Lab grown (CVD)">{b}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="verdict lede">Our view: choose natural if rarity matters to you, and lab grown if you would rather have a bigger or better stone for the same money. We will show you both.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2>The 4Cs, simply</h2>
        <p>Every diamond certificate grades these four things.</p>
      </div>
      <dl class="cs">
        {FOUR_C.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd class="muted">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section band">
    <div class="wrap split metal">
      <div>
        <h2>Gold purity and hallmarks</h2>
        <p class="lede muted">Karat tells you how much of the metal is pure gold. The rest is other metals that make it stronger or change its colour.</p>
        <table class="gold">
          <caption class="sr-only">Gold karats and purity</caption>
          <thead><tr><th scope="col">Karat</th><th scope="col">Pure gold</th><th scope="col">Best for</th></tr></thead>
          <tbody>
            {GOLD.map(([k, p, t]) => <tr><th scope="row">{k}</th><td>{p}</td><td>{t}</td></tr>)}
          </tbody>
        </table>
      </div>
      <div class="metal__notes">
        <div>
          <h3>BIS hallmark</h3>
          <p class="muted">In India, gold jewellery is hallmarked by the Bureau of Indian Standards. Look for the BIS mark, the purity, for example 22K916, and a six character HUID code. You can check any HUID yourself in the free BIS CARE app.</p>
        </div>
        <div>
          <h3>925 silver</h3>
          <p class="muted">Sterling silver is 92.5 percent pure silver, with a little copper for strength. Our silver pieces are stamped 925.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="workshop">
    <div class="wrap split split--wide-right checks">
      <div class="photo checks__photo"><Img name="bench-hands" sizes="(min-width: 900px) 40vw, 100vw" /></div>
      <div class="checks__text">
        <h2>How we check every piece</h2>
        <p class="lede">We make our jewellery in house, so we can check it at every stage instead of trusting someone else's word.</p>
        <ul class="ticks">
          {CHECKS.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Faq items={FAQ_DIAMONDS} />
</Base>

<style>
  .compare { width: 100%; border-collapse: collapse; }
  .compare th, .compare td { text-align: left; vertical-align: top; padding: 1rem 1.25rem 1rem 0; border-bottom: 1px solid var(--line); }
  .compare thead th { font-family: var(--display); font-variation-settings: "SOFT" 100; font-weight: 400; font-size: var(--step-3); padding-bottom: 1.25rem; border-bottom-color: var(--sona); }
  .compare tbody th { font-weight: 600; width: 18%; padding-right: 1.5rem; }
  .compare thead th { white-space: nowrap; }
  .compare td { color: var(--ink-soft); width: 39%; }
  @media (max-width: 699px) {
    .compare thead { display: none; }
    .compare, .compare tbody, .compare tr, .compare th, .compare td { display: block; width: 100%; }
    .compare tr { padding-block: 1.25rem; border-bottom: 1px solid var(--line); }
    .compare th, .compare td { border: 0; padding: 0; }
    .compare tbody th { margin-bottom: 0.6rem; }
    .compare td { padding-left: 0; margin-top: 0.4rem; }
    .compare td::before { content: attr(data-label); display: block; font-size: 0.85rem; font-weight: 600; color: var(--ink); }
  }
  .verdict { margin-top: 2rem; max-width: 46rem; }

  .cs { display: grid; gap: 2rem 1.5rem; margin: 0; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
  .cs div { padding-top: 1rem; border-top: 1px solid var(--sona); }
  .cs dt { font-family: var(--display); font-variation-settings: "SOFT" 100; font-size: var(--step-4); line-height: 1; margin-bottom: 0.75rem; }
  .cs dd { margin: 0; }

  .metal { align-items: start; }
  .metal h2 { margin-bottom: 1.25rem; }
  .gold { width: 100%; border-collapse: collapse; margin-top: 2rem; }
  .gold th, .gold td { text-align: left; vertical-align: top; padding: 0.85rem 1rem 0.85rem 0; border-bottom: 1px solid var(--line); }
  .gold thead th { font-size: 0.9rem; font-weight: 600; color: var(--ink-soft); white-space: nowrap; }
  .gold tbody th { font-family: var(--display); font-variation-settings: "SOFT" 100; font-weight: 400; font-size: var(--step-2); }
  .gold td:nth-child(2) { white-space: nowrap; }
  .metal__notes { display: grid; gap: 2rem; }
  .metal__notes > div { padding: 1.75rem; background: var(--paper); border-radius: 8px; }
  .metal__notes h3 { margin-bottom: 0.6rem; }

  .checks { align-items: start; }
  .checks__photo { aspect-ratio: 4 / 5; }
  .checks__text { display: grid; gap: 1.5rem; }
  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
  .ticks li { position: relative; padding-left: 1.6rem; padding-bottom: 0.9rem; border-bottom: 1px solid var(--line); }
  .ticks li::before {
    content: ""; position: absolute; left: 0; top: 0.55em; width: 0.6rem; height: 0.6rem;
    border: 1px solid var(--sona); transform: rotate(45deg);
  }
</style>
