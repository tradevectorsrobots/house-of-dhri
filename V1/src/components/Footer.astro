---
import { COLLECTIONS, WHATSAPP_DISPLAY, waLink } from "../data/site.js";

const year = new Date().getFullYear();
---
<footer data-testid="site-footer" class="bg-[#1A1714] text-[#F6F1E8]">
  <div class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 pt-24 pb-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-14">
      <div class="lg:col-span-6">
        <img src="/brand/logo-full.webp" alt="House of Dhri — Lab-grown diamond jewellery" width="1672" height="1102" loading="lazy" decoding="async" class="w-auto h-32 sm:h-40" />
        <p class="font-display text-4xl sm:text-5xl leading-[1.05] mt-8 max-w-lg">
          Distinctive by design. <em class="text-[#CDB894]">Brilliant by nature.</em>
        </p>
      </div>
      <div class="lg:col-span-3">
        <p class="overline text-[#CDB894] mb-6">Collections</p>
        <ul class="space-y-3 text-[#F6F1E8]/80">
          {COLLECTIONS.map((c) => (
            <li><a href={`/collections/${c.slug}`} data-testid={`footer-link-${c.slug}`} class="link-line">{c.name}</a></li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-3">
        <p class="overline text-[#CDB894] mb-6">The House</p>
        <ul class="space-y-3 text-[#F6F1E8]/80">
          <li><a href="/our-story" data-testid="footer-link-story" class="link-line">Our Story</a></li>
          <li><a href="/diamonds-and-materials" data-testid="footer-link-diamonds" class="link-line">Diamonds &amp; Materials</a></li>
          <li><a href="/contact" data-testid="footer-link-contact" class="link-line">Private Enquiries</a></li>
          <li><a href={waLink()} target="_blank" rel="noreferrer" data-testid="footer-whatsapp" class="link-line">WhatsApp {WHATSAPP_DISPLAY}</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-24 select-none font-display font-semibold uppercase text-[8.6vw] lg:text-[8.4vw] leading-[0.85] tracking-[0.06em] text-[#F6F1E8]/[0.08] whitespace-nowrap overflow-hidden" aria-hidden="true">
      House of Dhri
    </div>
    <div class="mt-8 pt-6 border-t border-[#F6F1E8]/15 flex flex-col sm:flex-row justify-between gap-3 text-xs text-[#F6F1E8]/60">
      <p>© {year} House of Dhri. All rights reserved.</p>
      <p class="font-mono-x tracking-[0.2em] uppercase">Lab-grown diamonds · India</p>
    </div>
  </div>
</footer>
