---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Overline from "../../components/Overline.astro";
import Reveal from "../../components/Reveal.astro";
import PieceGrid from "../../components/PieceGrid.astro";
import Icon from "../../components/Icon.astro";
import { PRODUCTS, productsIn } from "../../data/products.js";
import { getCollection, waLink } from "../../data/site.js";
import { breadcrumbList, productSchema } from "../../data/seo.js";

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const c = getCollection(p.collection);
const related = productsIn(p.collection).filter((x) => x.slug !== p.slug);
const path = `/pieces/${p.slug}`;

const schema = [
  breadcrumbList([["Home", "/"], ["Collections", "/collections"], [c.name, `/collections/${c.slug}`], [p.name, path]]),
  productSchema(p, c),
];
---
<BaseLayout
  title={`${p.name} — ${p.line}`}
  description={`${p.name}: ${p.note} Price on enquiry.`}
  path={path}
  image={p.images[0]}
  imageAlt={`${p.name} — ${p.line}`}
  ogType="product"
  schema={schema}
>
  <link slot="head" rel="preload" as="image" href={p.images[0]} fetchpriority="high" />
  <div data-testid="product-page" class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 pt-32 sm:pt-40 pb-24 grid grid-cols-1 lg:grid-cols-12 gap-12">
    <div class="lg:col-span-7">
      <div class="grid grid-cols-1 sm:grid-cols-[88px_1fr] gap-4" data-gallery>
        <div class="order-2 sm:order-1 flex sm:flex-col gap-3">
          {p.images.map((src, k) => (
            <button
              type="button"
              data-gallery-thumb={k}
              data-testid={`product-thumb-${k}`}
              aria-label={`Show view ${k + 1}`}
              aria-pressed={k === 0 ? "true" : "false"}
              class={`w-20 sm:w-full aspect-[4/5] overflow-hidden border transition-[border-color,opacity] duration-300 ${k === 0 ? "border-[#F6F1E8] opacity-100" : "border-transparent opacity-60 hover:opacity-100"}`}
            >
              <img src={src} alt={`${p.name} view ${k + 1}`} width="1288" height="1920" decoding="async" class="h-full w-full object-cover" />
            </button>
          ))}
        </div>
        <div data-gallery-stage class="order-1 sm:order-2 relative aspect-[4/5] overflow-hidden bg-[#2E2A25] cursor-zoom-in">
          {p.images.map((src, k) => (
            <img
              src={src}
              alt={p.name}
              width="1288"
              height="1920"
              decoding="async"
              fetchpriority={k === 0 ? "high" : undefined}
              data-gallery-img={k}
              data-testid={k === 0 ? "product-main-image" : undefined}
              class={`pg-img absolute inset-0 h-full w-full object-cover ${k === 0 ? "is-current" : ""}`}
            />
          ))}
          <span class="absolute left-4 bottom-4 overline text-[0.6rem] bg-[#26231F]/85 backdrop-blur px-3 py-1.5">Design render</span>
        </div>
      </div>
    </div>
    <Reveal class="lg:col-span-4 lg:col-start-9 lg:sticky lg:top-32 self-start">
      <a href={`/collections/${c.slug}`} data-testid="product-collection-link" class="inline-flex items-center gap-2 overline text-[#CDB894] link-line">
        <Icon name="arrow-left" class="h-3 w-3" /> {c.name}
      </a>
      <h1 data-testid="product-name" class="font-display font-light text-5xl sm:text-6xl mt-5 leading-[0.95]">{p.name}</h1>
      <p class="mt-3 text-[#F6F1E8]/70">{p.line}</p>
      <p data-testid="product-price" class="mt-5 font-display italic text-2xl text-[#CDB894]">Price on enquiry</p>
      <p class="mt-6 text-[#F6F1E8]/75 leading-relaxed">{p.note}</p>
      <dl class="mt-10 border-t border-[#F6F1E8]/15" data-testid="product-specs">
        {p.specs.map((s) => (
          <div class="grid grid-cols-[120px_1fr] gap-4 py-4 border-b border-[#F6F1E8]/15">
            <dt class="overline text-[0.65rem] text-[#CDB894] pt-1">{s.label}</dt>
            <dd class="font-display text-xl">{s.value}</dd>
          </div>
        ))}
      </dl>
      <a href={waLink(`Hello House of Dhri, I'd like to enquire about "${p.name}".`)} target="_blank" rel="noreferrer" data-testid="product-whatsapp-button" class="mt-10 flex items-center justify-center gap-3 rounded-full bg-[#F6F1E8] text-[#26231F] py-5 text-sm tracking-[0.12em] uppercase hover:bg-[#B39A70] transition-colors duration-300">
        <Icon name="message-circle" class="h-4 w-4" strokeWidth={1.5} /> Enquire on WhatsApp
      </a>
      <Overline class="mt-6">Price · specifications · availability · customisation</Overline>
      <p class="mt-8 text-xs text-[#F6F1E8]/65 leading-relaxed">Images are design renders. Final metal, stone and grading details are confirmed with you personally before you commit.</p>
    </Reveal>
  </div>
  {related.length > 0 && (
    <section data-testid="product-related" class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 pb-28 border-t border-[#F6F1E8]/15 pt-20">
      <h2 class="font-display font-light text-4xl sm:text-5xl mb-12">Also in {c.name}</h2>
      <PieceGrid items={related} />
    </section>
  )}
</BaseLayout>
