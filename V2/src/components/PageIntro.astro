---
import Img from "./Img.astro";

const { title, lede, image, ratio = "4 / 5", crumbs = [] } = Astro.props;
---
<section class="intro on-dark">
  <div class={`wrap intro__grid ${image ? "intro__grid--image" : ""}`}>
    <div class="intro__copy">
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="intro__crumbs">
          <ol>
            {crumbs.map(([label, href]) => (
              <li>{href ? <a href={href}>{label}</a> : <span aria-current="page">{label}</span>}</li>
            ))}
          </ol>
        </nav>
      )}
      <h1>{title}</h1>
      {lede && <p class="lede muted">{lede}</p>}
      <slot />
    </div>
    {image && (
      <div class="photo intro__photo" style={`aspect-ratio: ${ratio}`}>
        <Img name={image} sizes="(min-width: 900px) 40vw, 100vw" eager />
      </div>
    )}
  </div>
</section>

<style>
  .intro { padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem); }
  .intro__grid { display: grid; gap: 2.5rem; align-items: end; }
  @media (min-width: 900px) { .intro__grid--image { grid-template-columns: 7fr 5fr; } }
  .intro__copy { display: grid; gap: 1.5rem; justify-items: start; }
  .intro h1 { font-size: var(--step-6); max-width: 15ch; }
  .intro__crumbs ol { display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem; list-style: none; margin: 0; padding: 0; font-size: 0.9rem; }
  .intro__crumbs li + li::before { content: "/"; margin-right: 0.6rem; color: rgb(238 240 236 / 0.4); }
  .intro__crumbs a { color: rgb(238 240 236 / 0.74); text-decoration: none; }
  .intro__crumbs a:hover { color: var(--pearl); text-decoration: underline; }
  .intro__crumbs span { color: var(--sona-light); }
  @media (max-width: 899px) { .intro__photo { aspect-ratio: 4 / 3 !important; } }
</style>
