---
import Icon from "./Icon.astro";
import { productsIn } from "../data/products.js";

const { c, class: className = "", delay = 0, large = false } = Astro.props;
---
<div class={className} data-reveal data-amount="0.1" style={`--reveal-y: 40px; --reveal-dur: 1.1s; --reveal-delay: ${delay}s`}>
  <a
    href={`/collections/${c.slug}`}
    data-testid={`collection-card-${c.slug}`}
    class="group relative block h-full min-h-[460px] overflow-hidden bg-[#26231F] text-[#F6F1E8]"
  >
    <img
      src={c.image}
      alt={`${c.name} collection mood`}
      width="848"
      height="1264"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1600ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.06]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#26231F]/90 via-[#26231F]/20 to-transparent"></div>
    <div class="absolute inset-3 sm:inset-4 border border-[#F6F1E8]/0 transition-[border-color] duration-700 group-hover:border-[#F6F1E8]/40 pointer-events-none"></div>
    <div class="absolute top-6 left-6 right-6 flex items-start justify-between">
      <span class="font-display italic text-2xl text-[#F6F1E8]/90">{c.numeral}</span>
      <span data-testid={`collection-status-${c.slug}`} class="rounded-full bg-[#F6F1E8]/15 backdrop-blur-md border border-[#F6F1E8]/30 px-4 py-1.5 overline text-[0.65rem] text-[#F6F1E8]">
        {productsIn(c.slug).length} pieces
      </span>
    </div>
    <div class="absolute bottom-0 inset-x-0 p-6 sm:p-10 flex items-end justify-between gap-6">
      <div>
        <p class="overline text-[#E3D3B4] text-[0.65rem]">{c.line}</p>
        <h3 class={`font-display font-light uppercase tracking-[0.12em] mt-3 ${large ? "text-5xl sm:text-7xl" : "text-4xl sm:text-5xl"}`}>
          {c.name}
        </h3>
      </div>
      <span class="h-12 w-12 shrink-0 rounded-full border border-[#F6F1E8]/50 flex items-center justify-center transition-colors duration-500 group-hover:bg-[#F6F1E8] group-hover:text-[#26231F]">
        <Icon name="arrow-up-right" class="h-5 w-5 transition-transform duration-500 group-hover:rotate-45" strokeWidth={1.3} />
      </span>
    </div>
  </a>
</div>
