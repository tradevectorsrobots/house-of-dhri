---
import Overline from "./Overline.astro";
import MaskLines from "./MaskLines.astro";

const { overline, lines, intro, testid } = Astro.props;
---
<section data-testid={testid} class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 pt-36 sm:pt-44 pb-16 sm:pb-24">
  <Overline class="mb-8">{overline}</Overline>
  <h1 class="font-display font-light text-5xl sm:text-6xl lg:text-[5.5rem] leading-[0.95] tracking-[-0.01em] max-w-5xl">
    <MaskLines lines={lines} delay={0.1} />
  </h1>
  {intro && (
    <p class="anim-rise mt-10 max-w-xl text-base sm:text-lg leading-relaxed text-[#F6F1E8]/75" style="--from-y: 16px; --delay: 0.6s">
      {intro}
    </p>
  )}
</section>
