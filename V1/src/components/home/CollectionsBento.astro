---
import Overline from "../Overline.astro";
import Reveal from "../Reveal.astro";
import CollectionCard from "../CollectionCard.astro";
import { COLLECTIONS } from "../../data/site.js";

const [p, n, a] = COLLECTIONS;
---
<section data-testid="home-collections" class="mx-auto max-w-[1440px] px-6 sm:px-10 lg:px-16 pb-28 sm:pb-40">
  <Reveal class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 sm:mb-16">
    <div>
      <Overline>Three directions</Overline>
      <h2 class="font-display font-light text-4xl sm:text-6xl mt-5 leading-[1]">The collections</h2>
    </div>
    <p class="max-w-sm text-[#F6F1E8]/75 leading-relaxed">
      The first pieces are here. Explore each direction and enquire privately for price, specifications and availability.
    </p>
  </Reveal>
  <div class="grid grid-cols-1 lg:grid-cols-12 lg:grid-rows-[repeat(2,minmax(0,520px))] gap-4 sm:gap-5">
    <CollectionCard c={p} large class="lg:col-span-7 lg:row-span-2 min-h-[560px]" />
    <CollectionCard c={n} delay={0.12} class="lg:col-span-5" />
    <CollectionCard c={a} delay={0.24} class="lg:col-span-5" />
  </div>
</section>
