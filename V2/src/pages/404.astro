---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
---
<Base title="Page not found" description="This page is not here. Find custom jewellery, engagement rings and diamond guides from House of Dhri." path="/404/" noindex>
  <PageIntro title="This page is not here" lede="The link may be old or mistyped. These will take you somewhere useful.">
    <div class="actions">
      <a href="/" class="btn btn--pearl">Go to the home page</a>
      <a href="/collections/" class="btn btn--line-light">See the collections</a>
      <a href="/contact/" class="btn btn--line-light">Talk to us</a>
    </div>
  </PageIntro>
</Base>
